    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@playwright/test": "1.65.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
